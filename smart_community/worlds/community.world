<?xml version="1.0" ?>
<sdf version="1.6">

  <world name="competition_world">

    <!-- ==================== -->
    <!-- 基础环境 -->
    <!-- ==================== -->

    <include>
      <uri>model://sun</uri>
    </include>

    <gravity>0 0 -9.8</gravity>

    <!-- 4.2m × 4.2m 地面 -->
    <model name="competition_ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>4.2 4.2 0.02</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.2 4.2 0.02</size>
            </box>
          </geometry>

          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>

        </visual>

      </link>
    </model>


    <!-- ==================== -->
    <!-- 外围墙 -->
    <!-- ==================== -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 2.08 0.10 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.15 0.04 0.20</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.15 0.04 0.20</size>
            </box>
          </geometry>

          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="south_wall">
      <static>true</static>
      <pose>0 -2.08 0.10 0 0 0</pose>

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.15 0.04 0.20</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4.15 0.04 0.20</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>


    <model name="west_wall">
      <static>true</static>
      <pose>-2.08 0 0.10 0 0 0</pose>

      <link name="link">
        <collision name="collision">
