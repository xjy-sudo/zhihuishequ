<?xml version="1.0"?>
<sdf version="1.6">

  <model name="building_new_90">

    <static>true</static>

    <link name="building">
      <pose>0 0 0 0 0 1.5708</pose>

      <!--
        主体高度 = 0.35 m
        中心 Z = 0.175 m
        因此：
        底面 = 0.175 - 0.175 = 0
        保证坐落地面
      -->

      <collision name="building_collision">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.25 0.35</size>
          </box>
        </geometry>
      </collision>

      <visual name="building_body">
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <box>
            <size>0.30 0.25 0.35</size>
          </box>
        </geometry>

        <material>
          <ambient>0.45 0.50 0.54 1</ambient>
          <diffuse>0.45 0.50 0.54 1</diffuse>
        </material>
      </visual>

      <!-- 深色屋顶，最高点仍控制在约 0.37 m -->

      <visual name="roof">
        <pose>0 0 0.358 0 0 0</pose>
        <geometry>
          <box>
            <size>0.31 0.26 0.016</size>
          </box>
        </geometry>

        <material>
          <ambient>0.07 0.08 0.09 1</ambient>
          <diffuse>0.07 0.08 0.09 1</diffuse>
        </material>
      </visual>

      <!-- 青色屋顶装饰 -->

      <visual name="roof_panel">
        <pose>0 0 0.367 0 0 0</pose>
        <geometry>
          <box>
            <size>0.17 0.11 0.002</size>
          </box>
        </geometry>

        <material>
          <ambient>0.0 0.75 0.68 1</ambient>
          <diffuse>0.0 0.75 0.68 1</diffuse>
          <emissive>0.0 0.18 0.16 1</emissive>
        </material>
      </visual>

      <!-- 门：底部同样位于地面 -->

      <visual name="door">
