<?xml version="1.0"?>
<sdf version="1.6">

  <model name="fire_style_a_test">

    <static>true</static>

    <link name="fire_link">

      <!-- ========================= -->
      <!-- 红色外焰：最高 -->
      <!-- ========================= -->

      <visual name="red_outer">
        <pose>0 0 0.115 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.085</radius>
          </sphere>
        </geometry>

        <scale>0.85 0.85 1.45</scale>

        <material>
          <ambient>1 0.03 0.01 0.72</ambient>
          <diffuse>1 0.03 0.01 0.72</diffuse>
          <emissive>1 0.02 0 1</emissive>
        </material>

        <transparency>0.25</transparency>
      </visual>


      <!-- ========================= -->
      <!-- 左侧红色火舌 -->
      <!-- ========================= -->

      <visual name="red_left">
        <pose>-0.045 0 0.155 0 -0.22 0</pose>

        <geometry>
          <sphere>
            <radius>0.045</radius>
          </sphere>
        </geometry>

        <scale>0.65 0.65 1.65</scale>

        <material>
          <ambient>1 0.04 0.01 0.75</ambient>
          <diffuse>1 0.04 0.01 0.75</diffuse>
          <emissive>1 0.02 0 1</emissive>
        </material>

        <transparency>0.20</transparency>
      </visual>


      <!-- ========================= -->
      <!-- 右侧红色火舌 -->
      <!-- ========================= -->

      <visual name="red_right">
        <pose>0.045 0 0.145 0 0.25 0</pose>

        <geometry>
          <sphere>
            <radius>0.040</radius>
          </sphere>
        </geometry>

        <scale>0.65 0.65 1.55</scale>

        <material>
          <ambient>1 0.05 0.01 0.75</ambient>
          <diffuse>1 0.05 0.01 0.75</diffuse>
          <emissive>1 0.03 0 1</emissive>
        </material>

        <transparency>0.20</transparency>
      </visual>


      <!-- ========================= -->
      <!-- 橙色主体 -->
      <!-- ========================= -->

      <visual name="orange_middle">
        <pose>0 0 0.095 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.070</radius>
          </sphere>
        </geometry>

        <scale>0.90 0.90 1.25</scale>

        <material>
          <ambient>1 0.28 0.01 0.90</ambient>
          <diffuse>1 0.28 0.01 0.90</diffuse>
          <emissive>1 0.20 0 1</emissive>
        </material>

        <transparency>0.10</transparency>
      </visual>


      <!-- ========================= -->
      <!-- 黄色内焰 -->
      <!-- ========================= -->

      <visual name="yellow_inner">
        <pose>0 0 0.065 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.050</radius>
          </sphere>
        </geometry>

        <scale>0.90 0.90 1.20</scale>

        <material>
          <ambient>1 0.85 0.03 1</ambient>
          <diffuse>1 0.75 0.02 1</diffuse>
          <emissive>1 0.75 0.02 1</emissive>
        </material>
      </visual>


      <!-- ========================= -->
      <!-- 白黄色核心 -->
      <!-- ========================= -->

      <visual name="hot_core">
        <pose>0 0 0.040 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.030</radius>
          </sphere>
        </geometry>

        <scale>1 1 1.15</scale>

        <material>
          <ambient>1 1 0.35 1</ambient>
          <diffuse>1 1 0.25 1</diffuse>
          <emissive>1 0.9 0.25 1</emissive>
        </material>
      </visual>

    </link>

  </model>

</sdf>
