<?xml version="1.0" ?>

<sdf version="1.6">

  <model name="ground_map">

    <static>true</static>

    <link name="link">

      <collision name="collision">
        <geometry>
          <box>
            <size>4.2 4.2 0.02</size>
          </box>
        </geometry>
      </collision>


      <visual name="visual">

        <geometry>
          <box>
            <size>4.2 4.2 0.02</size>
          </box>
        </geometry>


        <material>

          <script>

            <uri>
              model://ground_map/materials/scripts
            </uri>

            <uri>
              model://ground_map/materials/textures
            </uri>

            <name>
              SmartCommunity/GroundMap
            </name>

          </script>

        </material>

      </visual>

    </link>

  </model>

</sdf>
